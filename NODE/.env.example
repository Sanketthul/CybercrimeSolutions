# Copy this file to .env and replace every placeholder before starting the API.
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/<database>?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
PORT=4000
CLIENT_ORIGIN=http://localhost:3000
ADMIN_SIGNUP_CODE=replace-with-your-own-secret